{
  "name": "mcpdict-backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test --preload ./tests/setup.ts",
    "typecheck": "tsc --noEmit",
    "data:fetch": "bun run scripts/data/fetch.ts",
    "data:validate": "bun run scripts/data/validate.ts",
    "data:fixture": "bun run scripts/data/fixture.ts",
    "createdb": "bun run data:fetch",
    "build": "docker build --build-arg TIMESTAMP=$(date +%s) -t mcpdict_backend .",
    "stop": "docker stop mcpdict_backend || true && docker rm mcpdict_backend || true",
    "work": "docker run -d -p 3000:3000 --name mcpdict_backend mcpdict_backend",
    "pb": "bun run scripts/publish.ts",
    "data:build:source": "bun run scripts/data/source-build.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "@vearvip/hanzi-utils": "1.0.11",
    "elysia": "1.4.17",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "5.9.3"
  }
}
